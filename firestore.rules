
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'admin';
    }

    function belongsToFamily(familyId) {
      let data = getUserData();
      return isSignedIn() && data != null && (data.familyId == familyId || data.role == 'admin');
    }

    match /users/{userId} {
      // Allow get if owner, admin, or in the same family
      allow get: if isOwner(userId) || isAdmin() || (isSignedIn() && getUserData().familyId == resource.data.familyId);
      
      // Allow list (queries) if signed in. 
      // Firestore will enforce that the query only returns documents the user has 'get' access to.
      allow list: if isSignedIn();
      
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /families/{familyId} {
      allow get: if belongsToFamily(familyId);
      allow create: if isSignedIn();
      allow update: if belongsToFamily(familyId);
      
      match /children/{childId} {
        allow read, write: if belongsToFamily(familyId);
      }
    }

    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /registrations/{familyId} {
        allow read, write: if belongsToFamily(familyId);
      }
    }
  }
}
