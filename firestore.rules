
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isFamilyMember(familyId) {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == familyId;
    }

    match /monitors/{monitorId} {
      allow read, write: if isAdmin();
    }

    match /{path=**}/children/{childId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && isFamilyMember(resource.data.familyId));
      allow write: if isAdmin() || (isSignedIn() && isFamilyMember(resource.data.familyId));
    }

    match /users/{userId} {
      // Permitimos listado y lectura a cualquier usuario autenticado para que los nuevos puedan encontrar miembros de su familia durante el registro
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /families/{familyId} {
      // Permitimos listado a cualquier usuario autenticado para la búsqueda inicial
      allow list: if isSignedIn();
      allow get: if isSignedIn(); // Necesario para verificar existencia al unirse
      allow create: if isSignedIn();
      allow update: if isFamilyMember(familyId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      
      match /registrations/{familyId} {
        allow read, write: if isFamilyMember(familyId) || isAdmin();
      }
    }
  }
}
