rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isFamilyMember(familyId) {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == familyId;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Permitir listar para encontrar miembros de la familia
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /families/{familyId} {
      allow get: if isFamilyMember(familyId) || isAdmin();
      allow create: if isSignedIn();
      allow update: if isFamilyMember(familyId) || isAdmin();
      allow list, delete: if isAdmin();
      
      match /children/{childId} {
        allow read, write: if isFamilyMember(familyId) || isAdmin();
      }
    }

    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      
      match /registrations/{familyId} {
        allow read, write: if isFamilyMember(familyId) || isAdmin();
      }
    }
  }
}