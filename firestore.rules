
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Obtiene los datos del usuario autenticado de forma segura.
    function getAuthData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getAuthData().role == 'admin';
    }

    function belongsToFamily(familyId) {
      let data = getAuthData();
      return isSignedIn() && data != null && (data.familyId == familyId || data.role == 'admin');
    }

    match /users/{userId} {
      // Regla crítica para evitar recursión: isOwner siempre primero
      allow get: if isOwner(userId) || isAdmin();
      
      // Permitir listado global para administradores
      allow list: if isAdmin();
      
      // Permitir listado filtrado por familia para usuarios normales (si Firestore valida la consulta)
      allow list: if isSignedIn() && resource.data.familyId == getAuthData().familyId;
      
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /families/{familyId} {
      allow get: if belongsToFamily(familyId);
      allow list: if isAdmin();
      allow create: if isSignedIn();
      allow update: if belongsToFamily(familyId);
      
      match /children/{childId} {
        allow read, write: if belongsToFamily(familyId);
      }
    }

    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /registrations/{familyId} {
        allow read, write: if belongsToFamily(familyId);
      }
    }
  }
}
