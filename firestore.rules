
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isFamilyMember(familyId) {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == familyId;
    }

    match /monitors/{monitorId} {
      allow read, write: if isAdmin();
    }

    // Regla específica para la subcolección de hijos dentro de una familia
    match /families/{familyId}/children/{childId} {
      allow list, get: if isAdmin() || isFamilyMember(familyId);
      allow write: if isAdmin() || isFamilyMember(familyId);
    }

    // Regla para permitir a los administradores realizar consultas de grupo (Collection Group) sobre todos los niños
    match /{path=**}/children/{childId} {
      allow list: if isAdmin();
    }

    match /users/{userId} {
      // Permisos abiertos para lectura/listado para que los nuevos usuarios encuentren familiares
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /families/{familyId} {
      // Permitimos listado y lectura a cualquier usuario autenticado para el onboarding
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isFamilyMember(familyId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      
      match /registrations/{familyId} {
        allow read, write: if isFamilyMember(familyId) || isAdmin();
      }
    }
  }
}
