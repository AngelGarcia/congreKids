
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getAuthData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let data = getAuthData();
      return isSignedIn() && data != null && data.isAdmin == true;
    }

    function belongsToFamily(familyId) {
      let data = getAuthData();
      return isSignedIn() && data != null && (data.familyId == familyId || data.isAdmin == true);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.familyId == getAuthData().familyId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /families/{familyId} {
      allow get: if belongsToFamily(familyId);
      allow list: if isAdmin();
      allow create: if isSignedIn();
      allow update: if belongsToFamily(familyId);
      
      match /children/{childId} {
        allow read, write: if belongsToFamily(familyId);
      }
    }

    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /registrations/{familyId} {
        allow read, write: if belongsToFamily(familyId);
      }
    }
  }
}
