
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Stores user profile information and their link to a family unit.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity (Firebase Auth UID)."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "photoURL": {
          "type": "string",
          "description": "URL to the user's profile picture."
        },
        "role": {
          "type": "string",
          "description": "The user's family role ('padre' or 'madre').",
          "enum": ["padre", "madre"]
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Whether the user has administrative privileges."
        },
        "familyId": {
          "type": "string",
          "description": "Reference to the Family entity this user belongs to."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "displayName", "email", "role", "isAdmin", "familyId", "createdAt"]
    },
    "Family": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Family",
      "type": "object",
      "description": "Represents a family unit that shares children and registrations.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Family."
        },
        "name": {
          "type": "string",
          "description": "Display name for the family (e.g., 'Familia García')."
        },
        "members": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of User IDs belonging to this family."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "members", "createdAt"]
    },
    "Child": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Child",
      "type": "object",
      "description": "Represents a child within a family.",
      "properties": {
        "id": { "type": "string" },
        "familyId": { "type": "string" },
        "name": { "type": "string" },
        "birthDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "familyId", "name", "birthDate"]
    },
    "Meeting": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Meeting",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "registrationDeadline": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "ageGroups": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "title", "date", "registrationDeadline", "status"]
    },
    "Registration": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Registration",
      "type": "object",
      "description": "Records a family's registration for a meeting.",
      "properties": {
        "id": { "type": "string", "description": "Equal to familyId" },
        "meetingId": { "type": "string" },
        "familyId": { "type": "string" },
        "registeredBy": { "type": "string", "description": "User ID who performed the last update" },
        "children": { "type": "array", "items": { "type": "string" } },
        "registeredAt": { "type": "string", "format": "date-time" },
        "lastUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "meetingId", "familyId", "children", "registeredAt"]
    }
  },
  "auth": { "providers": ["google.com"] },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "entityName": "User", "description": "User profile." } },
      { "path": "/families/{familyId}", "definition": { "entityName": "Family", "description": "Family unit metadata." } },
      { "path": "/families/{familyId}/children/{childId}", "definition": { "entityName": "Child", "description": "Children in the family." } },
      { "path": "/meetings/{meetingId}", "definition": { "entityName": "Meeting", "description": "Meeting details." } },
      { "path": "/meetings/{meetingId}/registrations/{familyId}", "definition": { "entityName": "Registration", "description": "Family registration for a meeting." } }
    ]
  }
}
