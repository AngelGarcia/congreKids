
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuario con rol familiar y privilegios de administración.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["padre", "madre"] },
        "isAdmin": { "type": "boolean" },
        "familyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "displayName", "email", "role", "isAdmin", "familyId", "createdAt"]
    },
    "Family": {
      "title": "Family",
      "description": "Unidad familiar que agrupa a padres e hijos.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "searchName": { "type": "string", "description": "Nombre normalizado para búsquedas sin tildes ni mayúsculas." },
        "members": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "searchName", "members", "createdAt"]
    },
    "Child": {
      "title": "Child",
      "description": "Perfil de un niño asociado a una familia.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "familyId": { "type": "string" },
        "name": { "type": "string" },
        "birthDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "familyId", "name", "birthDate"]
    },
    "Monitor": {
      "title": "Monitor",
      "description": "Voluntario que ayuda en las reuniones.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "phone": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "firstName", "isAvailable", "createdAt"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Detalles de una reunión o encuentro programado.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "registrationDeadline": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["upcoming", "closed"] },
        "ageGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "minMonths": { "type": "number" },
              "maxMonths": { "type": "number" },
              "allowsGuitar": { "type": "boolean" },
              "ratio": { "type": "number", "description": "Número de niños por cada monitor." }
            }
          }
        },
        "assignedMonitors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs de los monitores asignados a esta reunión."
        },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Registration": {
      "title": "Registration",
      "description": "Registro de asistencia de una familia a una reunión específica.",
      "type": "object",
      "properties": {
        "meetingId": { "type": "string" },
        "familyId": { "type": "string" },
        "familyName": { "type": "string" },
        "registeredBy": { "type": "string" },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "childId": { "type": "string" },
              "name": { "type": "string" },
              "ageGroupLabel": { "type": "string" },
              "guitarSelected": { "type": "boolean" }
            }
          }
        },
        "registeredAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Perfiles de usuario."
    },
    "/families/{familyId}": {
      "schema": { "$ref": "#/entities/Family" },
      "description": "Datos de unidades familiares."
    },
    "/families/{familyId}/children/{childId}": {
      "schema": { "$ref": "#/entities/Child" },
      "description": "Hijos de cada familia."
    },
    "/monitors/{monitorId}": {
      "schema": { "$ref": "#/entities/Monitor" },
      "description": "Agenda de monitores voluntarios."
    },
    "/meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/Meeting" },
      "description": "Reuniones programadas."
    },
    "/meetings/{meetingId}/registrations/{familyId}": {
      "schema": { "$ref": "#/entities/Registration" },
      "description": "Inscripciones de familias por reunión."
    }
  }
}
