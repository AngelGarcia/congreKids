
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user profile, identifying their family affiliation and administrative privileges.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["padre", "madre"] },
        "isAdmin": { "type": "boolean" },
        "familyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "displayName", "email", "role", "isAdmin", "familyId", "createdAt"]
    },
    "Family": {
      "title": "Family",
      "description": "A unit representing a family household, sharing children and meeting registrations.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "searchName": { "type": "string", "description": "Normalized name for insensitive searching." },
        "members": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "searchName", "members", "createdAt"]
    },
    "Child": {
      "title": "Child",
      "description": "A child profile associated with a family.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "familyId": { "type": "string" },
        "name": { "type": "string" },
        "birthDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "familyId", "name", "birthDate"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile data."
    },
    "/families/{familyId}": {
      "schema": { "$ref": "#/entities/Family" },
      "description": "Family group data."
    },
    "/families/{familyId}/children/{childId}": {
      "schema": { "$ref": "#/entities/Child" },
      "description": "Children within a family."
    },
    "/meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/Meeting" },
      "description": "Meeting details."
    },
    "/meetings/{meetingId}/registrations/{familyId}": {
      "schema": { "$ref": "#/entities/Registration" },
      "description": "Family registrations for a meeting."
    }
  }
}
